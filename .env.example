# ─── Copy this file to .env and fill in your real values ─────────────────────
# cp .env.example .env

# ── MySQL ──────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=StrongRootPass@2024
MYSQL_USER=howards_user
MYSQL_PASSWORD=HowardsDB@2024

# ── AWS S3 ─────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=howards-council-media
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=HowardsCouncilSuperLongSecretKeyForJWT2024MustBe256BitsMinimum

# ── Admin Panel ────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Howard@Admin2024
